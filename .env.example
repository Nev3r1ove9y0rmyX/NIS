# 复制为 .env 后填入本地值，绝不提交真实值。
# 分组顺序与 deploy/README.md、docs/soa-deployment.md 一致。
# 任何真实密码、Token、私钥都不能进入本文件的仓库版本。

# ========== 通用 ==========
APP_ENV=development
APP_LOG_LEVEL=INFO
APP_SECRET_KEY=replace-with-a-long-random-value
APP_BASE_URL=http://localhost:8000
CORS_ALLOWED_ORIGINS=http://localhost:5173

# ========== 认证（JWT）==========
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
JWT_ALG=RS256
JWT_KID=nis-key-1
JWT_PRIVATE_KEY_PATH=/run/secrets/jwt_private.pem
JWT_PUBLIC_KEY_PATH=/run/secrets/jwt_public.pem

# ========== 内部服务鉴权 ==========
# 服务间调用令牌，只在容器网络内使用，不进入前端。
INTERNAL_SERVICE_TOKEN=replace-with-a-long-random-value

# ========== 数据库（一个实例，按 Schema 分账号）==========
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_ROOT_PASSWORD=replace-me-too

IAM_DB_USER=nis_iam_app
IAM_DB_PASSWORD=replace-me
IAM_DB_NAME=nis_iam

RECON_DB_USER=nis_recon_app
RECON_DB_PASSWORD=replace-me
RECON_DB_NAME=nis_recon

ANALYSIS_DB_USER=nis_analysis_app
ANALYSIS_DB_PASSWORD=replace-me
ANALYSIS_DB_NAME=nis_analysis

DECISION_DB_USER=nis_decision_app
DECISION_DB_PASSWORD=replace-me
DECISION_DB_NAME=nis_decision

EXECUTION_DB_USER=nis_execution_app
EXECUTION_DB_PASSWORD=replace-me
EXECUTION_DB_NAME=nis_execution

AI_DB_USER=nis_ai_app
AI_DB_PASSWORD=replace-me
AI_DB_NAME=nis_ai

AUDIT_DB_USER=nis_audit_app
AUDIT_DB_PASSWORD=replace-me
AUDIT_DB_NAME=nis_audit
# 审计账号只追加：不要给它 UPDATE / DELETE 权限。

# ========== 内部服务地址（容器 DNS）==========
IAM_SERVICE_URL=http://iam-service:8001
RECON_SERVICE_URL=http://recon-service:8002
ANALYSIS_SERVICE_URL=http://analysis-service:8003
DECISION_SERVICE_URL=http://decision-service:8004
EXECUTION_SERVICE_URL=http://execution-service:8005
AI_SERVICE_URL=http://ai-service:8006
AUDIT_SERVICE_URL=http://audit-service:8007

# 服务间超时（秒）：连接 1 秒、总 3 秒、AI 15 秒，见 docs/service-contracts.md
HTTP_CONNECT_TIMEOUT=1
HTTP_TOTAL_TIMEOUT=3
AI_TIMEOUT_SECONDS=15

# ========== API 网关 ==========
GATEWAY_PORT=8000
GATEWAY_RATE_LIMIT_PER_MINUTE=120
GATEWAY_MAX_BODY_BYTES=2097152

# ========== AI 服务（可降级，不阻断人工流程）==========
AI_PROVIDER=local
AI_BASE_URL=http://127.0.0.1:11434
AI_MODEL=qwen2.5:7b
AI_API_KEY=replace-if-needed

# ========== 前端 ==========
VITE_API_BASE_URL=http://localhost:8000/api/v1

# ========== 演示数据脚本（只在本地 shell 设置，不要提交）==========
# NIS_ADMIN_USERNAME=admin
# NIS_ADMIN_PASSWORD=
# NIS_DEMO_PASSWORD=
