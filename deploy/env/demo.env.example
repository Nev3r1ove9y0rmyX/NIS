# DMZ 验收环境实例模板（Issue #17）
# 用法：cp .env.example .env 后，把本文件列出的键改为下列值；
# 口令类键仍需自行生成强口令（^[A-Za-z0-9_-]{12,}$）。
# 键位以根目录 .env.example 为唯一清单，本文件只给出与本地开发不同的子集。

APP_ENV=demo
APP_LOG_LEVEL=INFO
APP_SECRET_KEY=现场生成至少32位随机值
APP_BASE_URL=http://10.1.1.20
CORS_ALLOWED_ORIGINS=http://10.1.1.20

# 经 nginx 统一入口访问 API（同源，无需跨域）
VITE_API_BASE_URL=http://10.1.1.20/api/v1

# 边缘代理监听端口（宿主机）
HTTP_PORT=80

# AI 服务：DMZ 主机如需访问宿主机 Ollama，把 127.0.0.1 换成
# host.docker.internal（Docker Desktop）或软路由侧主机地址；
# AI 不可用时系统按契约降级，不阻断人工流程。
AI_PROVIDER=local
AI_BASE_URL=http://host.docker.internal:11434

# 其余数据库账号/内部令牌/JWT 键位与根 .env.example 相同；
# 迁移账号口令（*_MIGRATE_PASSWORD）只在执行迁移的运维会话中提供。
